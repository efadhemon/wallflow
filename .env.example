# Dev server host for Tauri (leave empty for local-only; set for remote/mobile HMR)
TAURI_DEV_HOST=$TAURI_DEV_HOST

# Build target platform (usually set by Tauri CLI: windows, darwin, linux, etc.)
TAURI_ENV_PLATFORM=$TAURI_ENV_PLATFORM

# Enable debug build (disables minify, enables sourcemaps). Set to any truthy value for debug.
TAURI_ENV_DEBUG=$TAURI_ENV_DEBUG

# URL of the public version.json used by the in-app update banner.
# Local Live Server example: http://127.0.0.1:5500/website/api/version.json
VITE_VERSION_API_URL=https://api.wallflow.efadhemon.dev/api/version.json
