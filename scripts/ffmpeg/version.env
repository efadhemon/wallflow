# FFmpeg that Wallflow bundles on Windows and macOS. The commit is checked
# after cloning, so a moved tag cannot change what gets built.
FFMPEG_TAG=n9.0.2
FFMPEG_COMMIT=946fcce07b6dcd0331c8cc609192aeff5e1924f8
# Bump when the build itself changes (flags, toolchain) for the same FFmpeg.
WALLFLOW_FFMPEG_BUILD=1
