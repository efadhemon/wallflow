{
  "name": "wallflow",
  "private": true,
  "version": "1.0.0",
  "author": "Emon Hossain",
  "repository": {
    "type": "git",
    "url": "https://github.com/efadhemon/wallflow.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check --ignore-path .prettierignore .",
    "prettier:fix": "prettier --write --ignore-path .prettierignore .",
    "version:sync": "node scripts/sync-version.mjs",
    "version:patch": "node scripts/bump-version.js patch && yarn version:sync",
    "version:minor": "node scripts/bump-version.js minor && yarn version:sync",
    "version:major": "node scripts/bump-version.js major && yarn version:sync"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.8.5",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@babel/core": "8",
    "@babel/eslint-parser": "^8.0.1",
    "@eslint/js": "9",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
