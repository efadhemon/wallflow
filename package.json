{
  "name": "wallflow",
  "private": true,
  "version": "1.1.0",
  "author": "Emon Hossain",
  "repository": {
    "type": "git",
    "url": "https://github.com/efadhemon/wallflow.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check --ignore-path .prettierignore .",
    "prettier:fix": "prettier --write --ignore-path .prettierignore .",
    "version:sync": "node scripts/sync-version.mjs",
    "version:patch": "node scripts/bump-version.js patch && yarn version:sync",
    "version:minor": "node scripts/bump-version.js minor && yarn version:sync",
    "version:major": "node scripts/bump-version.js major && yarn version:sync"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/eslint-parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
