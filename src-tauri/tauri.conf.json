{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallflow",
  "version": "../package.json",
  "identifier": "com.efadhemon.wallflow",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wallflow",
        "width": 1000,
        "height": 700,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https://th.wallhaven.cc https://w.wallhaven.cc; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:5500 https://wallflow.efadhemon.dev",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi", "dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "copyright": "© 2026 Emon Hossain",
    "license": "MIT",
    "shortDescription": "Rotate your desktop wallpaper on a schedule",
    "longDescription": "Wallflow picks images from folders you choose and rotates your desktop background on a schedule. It runs from the system tray on Ubuntu, Windows and macOS.",
    "createUpdaterArtifacts": false,
    "linux": {
      "deb": {
        "section": "utils",
        "depends": ["ffmpeg"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "externalBin": ["binaries/wallflow-live"]
  }
}
